# syntax=docker/dockerfile:1.7
#
# The Solana AutoProver container — `console-solana` / `tui-solana` — layered on the lean base
# image (scripts/Dockerfile), which carries no Rust on purpose. This adds a host Rust toolchain,
# Certora's SBF build subcommand, and the Solana platform-tools release a CVLR run builds with:
# roughly 3 GB, which is why it is an image of its own rather than a flag on the base one. It also
# bakes in the `cvlr_api_kb` manifest, which only a Rust toolchain can generate.
#
# It bundles no `run-confined` launcher. The CVLR backend confines every cargo build and its
# provider is fail-closed, so this image is run with both overlays — see
# scripts/docker-compose.solana.yml.
#
# Nothing here is private: rustup, crates.io and the platform-tools release are all public, which
# keeps the base image's "no SSH/private auth at all" property.

ARG BASE_IMAGE=autoprover-local:latest
FROM --platform=linux/amd64 ${BASE_IMAGE} AS solana

# No versions here. composer.scripts.solana_toolchain installs the ones the installed composer builds
# with, which is also how AIAutoProver's cloud image installs them; `... solana_toolchain versions`
# prints them.

# Inherited from the base service's build args through the compose template; the channel is baked
# into $BASE_IMAGE rather than chosen here. Declared so the build does not warn about it.
ARG CERTORA_CLI_PACKAGE

# The base image purges its C toolchain once the wheels are built; this one needs it permanently.
# `cargo check` — the fast tier of the compile gate, run per authored edit — compiles and *links*
# the project's build scripts for the host, and the SBF build does the same for every proc-macro in
# the graph. Only the target code goes through platform-tools' own LLVM. Without `cc`, the first
# thing a CVLR run does is fail with a linker error about a crate the author never wrote.
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# The toolchain lives under $AUTOPROVE_HOME, root-owned and world-readable — deliberately not under
# $HOME, which the base image makes world-*writable*: a read-only Landlock grant over a tree the
# confined build can also write is not a grant of anything. The sandbox policy follows these
# variables rather than assuming the installers' default locations
# (composer.sandbox.recipes reads all three).
ENV RUSTUP_HOME=/opt/autoprove/rustup \
    CARGO_HOME=/opt/autoprove/cargo \
    CERTORA_PLATFORM_TOOLS_ROOT=/opt/autoprove/solana \
    PATH=/opt/autoprove/cargo/bin:${PATH}

# The host Rust toolchain, `cargo certora-sbf`, and the platform-tools release, pre-unpacked: a
# confined build has no network and a read-only tools cache. Then the `cvlr_api_kb` manifest, which
# the entrypoint's setup-db ingests from the path below; the nightly that generates it is removed in
# the same layer. Then an empty ~/.gitconfig, which a confined build with a git dependency cannot
# start without. The module docstring has the reasons for each.
RUN python -m composer.scripts.solana_toolchain toolchain
RUN python -m composer.scripts.solana_toolchain api-manifest \
        --output "$AUTOPROVE_HOME/rag/cvlr_api_kb.rag.json"
RUN python -m composer.scripts.solana_toolchain gitconfig

# No permissions pass over the three trees above, and that is the point rather than an omission:
# `chmod` makes overlayfs copy a file up into the layer that runs it whether or not the mode
# actually changes, so recursing over ~3 GB of Rust and platform tools would store a second copy of
# all of it in this image. rustup, `cargo install` and the tools unpack all write under umask 022,
# so the runtime user (an arbitrary host UID) can already read them.

WORKDIR /work
