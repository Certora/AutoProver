{#- "Reaching a handler" for Pinocchio 0.8 and 0.9, whose account type is `AccountInfo`. -#}
{% import "cvlr_reaching_pinocchio_handler.j2" as pinocchio %}

{% macro opening() -%}
{{ pinocchio.opening(
    account="AccountInfo",
    key="key()",
    signature="fn process_instruction(program_id: &Pubkey, accounts: &[AccountInfo], data: &[u8])
    -> ProgramResult",
    note="This is `pinocchio::account_info::AccountInfo`, not the SDK's: the two are different types, "
    "and nothing that takes one takes the other.",
) }}
{%- endmacro %}

{% macro building_accounts() -%}
{{ pinocchio.building_accounts(account="AccountInfo", key="key()") }}
{%- endmacro %}

{% macro observing_state() -%}
{{ pinocchio.observing_state(
    account="AccountInfo",
    key="key()",
    read_data="`try_borrow_data()` (`try_borrow_mut_data()` to write)",
    write_lamports="`try_borrow_mut_lamports()`",
) }}
{%- endmacro %}
