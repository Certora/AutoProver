    pub fn setup() -> Self {
        let mut ctx = TestContext::new();
        let program_id = Pubkey::new_from_array(ID.to_bytes());
        ctx.add_program(&program_id, "../../target/deploy/{{ crate_id }}.so").unwrap();
        // create funded accounts: ctx.create_account().pubkey(kp.pubkey())
        //     .lamports(N).owner(system_program::ID).create().unwrap();
        // derive PDAs: Pubkey::find_program_address(&[b"seed", key.as_ref()], &program_id)
        // run any init instruction (see calling convention). Panic on setup failure.
        Self { ctx, program_id, /* ... */ }
    }
    // one `action_<name>` per instruction; fuzzable args get #[range(lo..hi)]:
    pub fn action_<name>(&mut self, #[range(0..1_000_000)] amount: u64) -> bool {
        self.ctx.program(self.program_id)
            .call(instruction::<Name> { amount })
            .accounts(accounts::<Name> { /* fields */ })
            .signers(&[&*self.some_keypair])
            .send().map(|o| o.is_success()).unwrap_or(false)
    }
    // The `-> bool` is "did this ACTION do what it was designed to do". For the positive action
    // above that is the instruction succeeding. For a NEGATIVE action — one that attempts something
    // the program must reject — a correct rejection is the action working, so it returns `true`:
    pub fn action_<name>_unauthorized(&mut self) -> bool {
        let res = self.ctx.program(self.program_id)
            .call(instruction::<Name> { /* ... */ })
            .accounts(accounts::<Name> { /* the wrong signer */ })
            .signers(&[&*self.other_signer])
            .send();
        fuzz_assert!(res.is_err(), "[<property title>] <what must be rejected> must fail");
        true   // NOT false — see below
    }
    // Return `false` only when the action could not be attempted at all. Crucible treats `false` as
    // a dead-end state and STOPS the action sequence there, so a negative action returning `false`
    // truncates every campaign that draws it.

- Anchor path conventions (use the API FACTS below — do NOT guess these):
    * `use {{ crate_id }}::*;` brings the crate's generated items into scope. `{{ crate_id }}` is
      the crate id in the facts, NOT the `#[program] pub mod <name>` module name — the
      module name does NOT change these crate-root paths.
{% if idl %}    * `{{ crate_id }}` is GENERATED from the program's IDL (it is already declared for you at the
      top of the file — do NOT write `declare_fuzz_program!`, and do NOT add the program as a
      dependency; it is not one). Instruction/accounts structs and `ID` are exactly as above, but
      account state types live under `{{ crate_id }}::state::*` and IDL-defined types under
      `{{ crate_id }}::types::*` — e.g. `read_anchor_account::<{{ crate_id }}::state::Foo>(&pda)`.
      Anything the program's Rust source has but its IDL does not (helper fns, consts, private
      types) is NOT available: derive it in the fixture instead.
{% endif %}    * Instruction args struct: `instruction::<PascalName>` — snake_case `foo_bar` → `instruction::FooBar`.
    * Accounts struct: `accounts::<PascalName>` — same PascalCase as the instruction.
    * Program id: the `ID` constant; make a Pubkey via `Pubkey::new_from_array(ID.to_bytes())`.
- Read the program source (via the tools) to confirm exact field names, PDA seeds
  (binary vs string), and signer requirements — the API facts + model below are a summary.
- Output ONLY the fixture module source (imports + struct + #[fuzz_fixture] impl).
  Do NOT write `fn main`, `#[invariant_test]`, or `#[crucible_fuzz]` — those are added later.

